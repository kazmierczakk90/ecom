rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global safety net (Default-deny catch-all)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.uid == request.auth.uid 
        && data.email is string && data.email.size() <= 256
        && (data.defaultVatSource == null || data.defaultVatSource is number)
        && (data.defaultVatTarget == null || data.defaultVatTarget is number)
        && (data.exchangeRate == null || data.exchangeRate is number)
        && (data.defaultShippingCostEUR == null || data.defaultShippingCostEUR is number)
        && (data.defaultCommissionPercent == null || data.defaultCommissionPercent is number)
        && (data.useMockSimulation == null || data.useMockSimulation is bool);
    }

    function isValidWorklist(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 128
        && data.productIds is list && data.productIds.size() <= 1000
        && data.ownerId == request.auth.uid;
    }

    // Match blocks conforming to our blueprint
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId);

      match /worklists/{worklistId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(worklistId) && isValidWorklist(request.resource.data);
        allow update: if isOwner(userId) && isValidId(worklistId) && isValidWorklist(request.resource.data);
        allow delete: if isOwner(userId) && isValidId(worklistId);
      }
    }
  }
}
